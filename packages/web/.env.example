# ==============================================================================
# KuraCode Web App Public Configuration (.env.example)
# Only PUBLIC build-time variables (Vite-exposed) may be set here.
# NEVER put server secrets or service role keys in this file.
# ==============================================================================

VITE_PUBLIC_APP_URL=https://www.genioussonu.me/extensions/kuracode
VITE_PUBLIC_API_URL=http://localhost:3000

# Public OAuth Client IDs
VITE_PUBLIC_GOOGLE_CLIENT_ID=
VITE_PUBLIC_GITHUB_CLIENT_ID=
VITE_PUBLIC_GITLAB_CLIENT_ID=
VITE_PUBLIC_MICROSOFT_CLIENT_ID=

# Supabase Public Anon Key
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile Public Site Key
VITE_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry Public DSN (Web App only - NEVER extension)
VITE_PUBLIC_SENTRY_DSN=

