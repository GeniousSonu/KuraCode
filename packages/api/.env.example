# ==============================================================================
# KuraCode API & Edge Service Configuration (.env.example)
# Contains both server secrets and public endpoints.
# NEVER commit .env.local to git.
# ==============================================================================

PORT=3000
NODE_ENV=development

# Core URLs
PUBLIC_APP_URL=https://www.genioussonu.me/extensions/kuracode
PUBLIC_API_URL=http://localhost:3000

# Server OAuth Secrets
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=

# Supabase Server Privileged Key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Transactional Email
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@kuracode.app

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile Verification
TURNSTILE_SECRET_KEY=

# Session / JWT Signatures
SESSION_SECRET=dev-session-secret-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production

# UptimeRobot Heartbeat
UPTIMEROBOT_HEARTBEAT_URL=

