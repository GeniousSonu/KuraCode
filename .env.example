# ==============================================================================
# KuraCode Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local to configure services: `pnpm setup:env`
# The application runs fully offline in Zero-Account mode without any variables.
# When you add a service's keys, its corresponding capability turns on automatically.
#
# NOTE: NEVER commit actual API keys or secrets to git. .env.local is gitignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION URLs (Public)
# ------------------------------------------------------------------------------
# Official site / app base URL
PUBLIC_APP_URL=https://www.genioussonu.me/extensions/kuracode
# API backend base URL (local dev: http://localhost:3000, production: your Cloudflare Worker / API domain)
PUBLIC_API_URL=http://localhost:3000
# Fixed Extension Identifiers
PUBLIC_CHROME_EXTENSION_ID=kmbodbaepkmhfeohkbfbkpmnnjfkknmg
PUBLIC_FIREFOX_EXTENSION_ID=kuracode@sahinur.islam

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD CONSOLE (Sign-In with Google)
# Where to get: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web)
# Authorized redirect URI: https://kmbodbaepkmhfeohkbfbkpmnnjfkknmg.chromiumapp.org/
# Guide: docs/setup/02-google-cloud.md
# ------------------------------------------------------------------------------
PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APP (Sign-In with GitHub)
# Where to get: GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Homepage URL: https://www.genioussonu.me/extensions/kuracode
# Authorization callback URL: https://kmbodbaepkmhfeohkbfbkpmnnjfkknmg.chromiumapp.org/
# Guide: docs/setup/01-github.md
# ------------------------------------------------------------------------------
PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. GITLAB OAUTH APP (Optional)
# Where to get: GitLab -> Preferences -> Applications -> Add new application
# Guide: docs/setup/09-gitlab-microsoft.md
# ------------------------------------------------------------------------------
PUBLIC_GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. MICROSOFT AZURE ENTRA ID (Optional)
# Where to get: Azure Portal -> App registrations -> New registration
# Guide: docs/setup/09-gitlab-microsoft.md
# ------------------------------------------------------------------------------
PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. SUPABASE (PostgreSQL 16, Auth, Realtime Sync, Storage)
# Where to get: Supabase Dashboard -> Project Settings -> API
# Public Anon Key: Safe in client because Row-Level Security (RLS) is enforced on all tables.
# Service Role Key: SERVER ONLY. Never expose to client bundles or git.
# Guide: docs/setup/04-supabase.md
# ------------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 7. RESEND (Transactional Email: Workspace Invites & Magic Links)
# Where to get: Resend Dashboard (https://resend.com) -> API Keys
# Sender Address: notifications@kuracode.app (or custom verified domain)
# Guide: docs/setup/05-resend.md
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@kuracode.app

# ------------------------------------------------------------------------------
# 8. UPSTASH REDIS (Rate Limiting & Quick-Share Ephemeral Cache)
# Where to get: Upstash Console (https://console.upstash.com) -> Redis -> Database -> REST API
# Note: Optional; KuraCode falls back to Postgres/in-memory rate limiting without Redis.
# Guide: docs/setup/07-upstash-redis.md
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE TURNSTILE (CAPTCHA / Bot Protection)
# Where to get: Cloudflare Dashboard -> Turnstile -> Add site (Managed mode)
# Guide: docs/setup/03-cloudflare.md
# ------------------------------------------------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 10. SENTRY (Error Tracking for Web App and Edge API)
# Where to get: Sentry.io -> Projects -> Settings -> Client Keys (DSN)
# Note: Configured strictly for Web App & Server API with PII/snippet scrubbing; NEVER extension.
# Guide: docs/setup/06-sentry.md
# ------------------------------------------------------------------------------
PUBLIC_SENTRY_DSN=
SENTRY_SERVER_DSN=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 11. UPTIMEROBOT (Uptime Monitoring & Heartbeat)
# Where to get: UptimeRobot -> My Settings -> Integrations -> Heartbeats / Monitor
# Guide: docs/setup/08-uptimerobot.md
# ------------------------------------------------------------------------------
UPTIMEROBOT_HEARTBEAT_URL=
UPTIMEROBOT_API_KEY=

# ------------------------------------------------------------------------------
# 12. STORE PUBLISHING CREDENTIALS (GitHub Actions Secrets in Protected Environments)
# Where to configure: GitHub Repo -> Settings -> Environments -> chrome-web-store, edge-addons, firefox-amo
# Guide: docs/setup/10-stores.md
# ------------------------------------------------------------------------------
# Chrome Web Store
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Microsoft Edge Add-ons
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=

# Mozilla Firefox Add-ons (AMO)
FIREFOX_API_KEY=
FIREFOX_API_SECRET=
FIREFOX_EXTENSION_ID=kuracode@sahinur.islam

# ------------------------------------------------------------------------------
# 13. OWNER OVERRIDES (Set to "true" to force disable any capability)
# ------------------------------------------------------------------------------
# DISABLE_AUTH_GOOGLE=false
# DISABLE_AUTH_GITHUB=false
# DISABLE_AUTH_GITLAB=false
# DISABLE_AUTH_MICROSOFT=false
# DISABLE_AUTH_MAGICLINK=false
# DISABLE_EMAIL_SEND=false
# DISABLE_DB_CLOUD=false
# DISABLE_REALTIME=false
# DISABLE_STORAGE_CLOUD=false
# DISABLE_RATELIMIT_REDIS=false
# DISABLE_CAPTCHA=false
# DISABLE_ERRORS_SENTRY=false
# DISABLE_UPTIME_STATUS=false
