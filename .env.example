# Example Environment Configuration for KuraCode CI and Release Automation
# NOTE: NEVER commit actual API keys or secrets to git.

# -------------------------------------------------------------
# 1. Chrome Web Store API (OAuth2)
# Documentation: https://developer.chrome.com/docs/webstore/using_webstore_api/
# -------------------------------------------------------------
CHROME_EXTENSION_ID=your_chrome_extension_id_here
CHROME_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com
CHROME_CLIENT_SECRET=your_google_cloud_client_secret
CHROME_REFRESH_TOKEN=your_oauth_refresh_token

# -------------------------------------------------------------
# 2. Microsoft Edge Add-ons API
# Documentation: https://learn.microsoft.com/microsoft-edge/extensions-chromium/publish/api/
# -------------------------------------------------------------
EDGE_PRODUCT_ID=your_edge_product_uuid_here
EDGE_CLIENT_ID=your_azure_ad_client_id
EDGE_API_KEY=your_edge_api_key_or_secret

# -------------------------------------------------------------
# 3. Mozilla Firefox Add-ons (AMO) API
# Documentation: https://addons-server.readthedocs.io/en/latest/topics/api/auth.html
# -------------------------------------------------------------
FIREFOX_API_KEY=user:your_amo_jwt_issuer_key
FIREFOX_API_SECRET=your_amo_jwt_secret
FIREFOX_EXTENSION_ID=kuracode@sahinur.islam

# -------------------------------------------------------------
# 4. Optional: Future Surfaces
# -------------------------------------------------------------
VSCE_PAT=your_azure_devops_personal_access_token_for_vscode_marketplace
OPEN_VSX_TOKEN=your_open_vsx_token
