# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit binary files (never touch line endings)
*.png binary
*.ico binary
*.svg text eol=lf
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.xpi binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist overrides
packages/test-fixtures/fixtures/* linguist-vendored=true
brand/generated/* linguist-generated=true
docs/agent/evidence/* linguist-generated=true
